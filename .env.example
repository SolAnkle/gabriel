# ---------- Brain ----------
# Without a key the agent runs a scripted offline brain (for testing the plumbing only).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Optional extra direction for genesis (or pass --seed "...")
GENESIS_SEED=

# ---------- Trading ----------
# paper (default): simulated fills at live prices. live: real swaps (Jupiter, PumpPortal fallback).
TRADING_MODE=paper
# Live mode ALSO requires this. Two switches, so one typo can't spend money.
I_UNDERSTAND_THIS_SPENDS_REAL_MONEY=false
AGENT_WALLET_SECRET_KEY=          # base58 secret key, live mode only. Use a dedicated hot wallet.
AGENT_WALLET_ADDRESS=             # label for the wallet in paper mode
AGENT_COIN_ADDRESS=               # his coin's mint, once launched (needed to claim PumpSwap fees)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com   # use a paid RPC (Helius, Triton...) for live
PAPER_STARTING_TREASURY_USD=10000
# Kill switch for new buys (exits keep running). Also: `node src/cli.js pause` / `resume`.
PAUSE_TRADING=false

# ---------- Live execution ----------
MIN_SOL_RESERVE=0.05              # SOL always kept for transaction fees
PRIORITY_LEVEL=high               # medium | high | veryHigh
MAX_PRIORITY_FEE_LAMPORTS=2000000 # cap per transaction (0.002 SOL)
PUMPPORTAL_PRIORITY_FEE_SOL=0.0005
SWAP_ATTEMPTS=3
CONFIRM_TIMEOUT_SEC=60

# ---------- Creator fees ----------
CLAIM_CREATOR_FEES=false          # live: claim pump.fun creator fees from the market tick
MIN_CLAIM_SOL=0.05                # skip claims smaller than this
CLAIM_INTERVAL_HOURS=6            # fallback cadence when the pending amount can't be read

# ---------- Profit sweep to a cold wallet ----------
SWEEP_TO_ADDRESS=
SWEEP_ABOVE_SOL=0                 # e.g. 20: anything above 20 SOL in the hot wallet gets swept. 0 = off

# ---------- Alerts (trades, claims, errors, sweeps, posts) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- Risk limits (enforced in code; the brain can't change these) ----------
BUCKET_RESERVE=0.4
BUCKET_TRADING=0.3
BUCKET_OPERATIONS=0.2
BUCKET_EXPERIMENTAL=0.1
MAX_TRADE_USD=500
MAX_TRADE_PCT_OF_TREASURY=0.05
MAX_POSITION_PCT_OF_TREASURY=0.08
MAX_OPEN_POSITIONS=8
MIN_LIQUIDITY_USD=25000
MIN_VOLUME_24H_USD=50000
MIN_TOKEN_AGE_MINUTES=30
MAX_TOP10_HOLDER_PCT=0.45
MIN_ORGANIC_SCORE=20
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_PCT=2
STOP_LOSS_PCT=-0.5
TAKE_PROFIT_PCT=2
TAKE_PROFIT_SELL_FRACTION=0.5
MAX_HOLD_HOURS=72
MENTION_LOCK_HOURS=24
DAILY_LOSS_LIMIT_PCT=0.1
MAX_TRADES_PER_DAY=6
COOLDOWN_MINUTES_PER_TOKEN=720
MIN_CONVICTION=7
ALLOWED_CHAINS=solana

# ---------- X ----------
# dry-run (default): posts are written and checked, then logged instead of sent.
X_MODE=dry-run
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=                   # reads (mentions, watched KOLs) need a paid X API tier
X_USER_ID=
X_WATCH_HANDLES=                  # comma-separated accounts he reads and may reply to
MAX_POSTS_PER_DAY=12
MAX_REPLIES_PER_DAY=30
MIN_MINUTES_BETWEEN_POSTS=45
REPLY_COOLDOWN_HOURS_PER_USER=6

# ---------- Loop cadence (minutes) ----------
MARKET_TICK_MINUTES=10
SOCIAL_TICK_MINUTES=15
REFLECTION_TICK_MINUTES=1440
EXIT_REVIEW_MINUTES=360
